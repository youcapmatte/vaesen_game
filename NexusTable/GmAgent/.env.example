# Copy to .env.local (ignored by git).

# LiveKit Cloud project (Settings > Keys). The same values go in the API's LiveKit settings.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech to text, Claude, and voices.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVEN_API_KEY=

# The Nexus Table API, and the key it expects in X-Agent-Key (LiveKit:AgentKey in the API settings).
NEXUS_API_URL=http://localhost:5240
NEXUS_AGENT_KEY=nexus-table-local-agent-key

# Optional overrides.
# NEXUS_GM_MODEL=claude-haiku-5-5
# NEXUS_NARRATOR_VOICE=        # an ElevenLabs voice id for the narrator
# NEXUS_NPC_VOICE=             # one shared voice for every NPC, for now
# NEXUS_TTS_MODEL=eleven_flash_v2_5
