<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Nexus Table on AWS, as an AWS CDK app. Run through deploy.ps1 (see README.md), not on its own. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- cdk.out holds copies of the services' sources, staged as image build contexts. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);cdk.out/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.CDK.Lib" Version="2.274.0" />
    <PackageReference Include="Constructs" Version="10.8.1" />
  </ItemGroup>

</Project>
