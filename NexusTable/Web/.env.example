# Copy to .env.local. Without the AUTH0_* values the app runs with the dev login only.

# The Nexus Table API (NexusTable/Api/Nexus.Table.Api).
NEXT_PUBLIC_API_URL=http://localhost:5240

# Shows the dev player picker (needs the API in Development).
NEXT_PUBLIC_DEV_LOGIN=true

# Auth0 with the Discord social connection (Auth0 dashboard: Applications > Regular Web Application).
APP_BASE_URL=http://localhost:3030
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
# Must match Auth0:Audience in the API's appsettings.
AUTH0_AUDIENCE=https://api.nexustable.game
# Name of the Discord connection in Auth0 (Authentication > Social).
AUTH0_CONNECTION=discord
